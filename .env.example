# Your Mailtea API key: https://studio.mailtea.app/api-keys
MAILTEA_API_KEY=mt_pat_your_key_here

# The address emails go out as. Its domain has to be verified in Mailtea.
MAILTEA_FROM=Acme <hello@acme.com>

# Where this example sends. Use an inbox you can actually open.
MAILTEA_TO=you@yourdomain.com

# Only for local dev or a self-hosted Mailtea. Leave it unset in production.
# MAILTEA_API_BASE_URL=http://localhost:7787
